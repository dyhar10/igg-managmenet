# Salin file ini menjadi .env dan sesuaikan nilainya.
# DATABASE_URL digunakan aplikasi (via Prisma Client) untuk koneksi pooling
# DIRECT_URL digunakan untuk migrasi dan seeding sehingga bypass pool (mis. PgBouncer)
DATABASE_URL="postgresql://user:password@db-host:5432/igg_app?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:password@db-host:5432/igg_app?schema=public"

# Rahasia JWT default sangat lemah, ganti ke nilai acak panjang di produksi
JWT_SECRET="ubah-ini-di-produksi"
# Waktu kedaluwarsa token (detik)
TOKEN_EXPIRATION_SECONDS=3600
# Port aplikasi backend
PORT=4000
