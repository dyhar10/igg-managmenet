{
  "name": "backend",
  "version": "1.0.0",
  "description": "Lightweight monolithic backend for neighborhood administration app",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/run-prisma.js migrate deploy",
    "prisma:migrate-dev": "node scripts/run-prisma.js migrate dev",
    "prisma:seed": "node scripts/run-prisma.js db seed"
  },
  "keywords": [
    "monolith",
    "neighborhood",
    "administration"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.16.1",
    "express": "^4.19.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.16.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
